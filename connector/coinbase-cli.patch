+//! `cbase`'s reads as MCP tools, at the agreed JSON boundary.
+//!
+//! [`tools`] returns the `tools/list` entries and [`call`] returns a
+//! `CallToolResult`, both as plain JSON, so any shell can serve them: a stdio
+//! adapter (`cbase mcp`), a local `--http` adapter, or the JS Worker that
+//! loads this crate compiled to WebAssembly. The tool names, schemas and
+//! results are defined once, here.
+//!
+//! Every tool is read-only, and says so in its annotations.
+
+use pk_cli_core::CliError;
+use serde_json::{json, Value};
+
+use crate::client::Coinbase;
+use crate::http::Transport;
+use crate::queries;
+
+/// The `tools/list` entries.
+pub fn tools() -> Value {
+    let read_only = json!({
+        "readOnlyHint": true,
+        "destructiveHint": false,
+        "idempotentHint": true,
+        "openWorldHint": true,
+    });
+    json!([
+        {
+            "name": "coinbase_accounts_list",
+            "title": "Coinbase wallets and balances",
+            "description": "List the Coinbase wallets on the connected CDP API key with their \
+                balances (crypto-account-list/v1). Zero-balance wallets are hidden unless \
+                `all` is true. Amounts are strings at Coinbase's precision.",
+            "inputSchema": {
+                "type": "object",
+                "properties": {
+                    "limit": {"type": "integer", "minimum": 1, "description": "Maximum wallets to return."},
+                    "all": {"type": "boolean", "description": "Include zero-balance wallets."}
+                },
+                "additionalProperties": false
+            },
+            "annotations": read_only,
+        },
+        {
+            "name": "coinbase_transactions_list",
+            "title": "Coinbase transaction history",
+            "description": "List one wallet's transactions (crypto-transaction-list/v1), newest \
+                first, optionally bounded by an inclusive ISO date range. `account` is an `id` \
+                from coinbase_accounts_list.",
+            "inputSchema": {
+                "type": "object",
+                "properties": {
+                    "account": {"type": "string", "description": "Wallet id from coinbase_accounts_list."},
+                    "limit": {"type": "integer", "minimum": 1, "description": "Maximum transactions to return."},
+                    "since": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Only on or after this date (YYYY-MM-DD)."},
+                    "until": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Only on or before this date (YYYY-MM-DD)."}
+                },
+                "required": ["account"],
+                "additionalProperties": false
+            },
+            "annotations": read_only,
+        }
+    ])
+}
+
+/// Run one tool and shape the answer as a `CallToolResult`.
+///
+/// Failures are tool results with `isError: true`, not protocol errors: the
+/// model should see "the key was rejected (exit 3)" and act on it. The
+/// family's error code and exit code ride along in `structuredContent`.
+pub async fn call<T: Transport>(client: &Coinbase<T>, name: &str, args: &Value) -> Value {
+    match dispatch(client, name, args).await {
+        Ok(payload) => json!({
+            "content": [{"type": "text", "text": payload.to_string()}],
+            "structuredContent": payload,
+            "isError": false,
+        }),
+        Err(e) => error_result(&e),
+    }
+}
+
+/// A `CallToolResult` for a failure that happened before any tool ran, such
+/// as a credential that does not parse.
+pub fn error_result(e: &CliError) -> Value {
+    let mut body = e.to_json();
+    body["error"]["exit_code"] = json!(e.exit_code());
+    json!({
+        "content": [{"type": "text", "text": format!("{e} (exit {})", e.exit_code())}],
+        "structuredContent": body,
+        "isError": true,
+    })
+}
+
+async fn dispatch<T: Transport>(
+    client: &Coinbase<T>,
+    name: &str,
+    args: &Value,
+) -> Result<Value, CliError> {
+    match name {
+        "coinbase_accounts_list" => {
+            let accounts =
+                queries::accounts(client, bool_arg(args, "all")?, u32_arg(args, "limit")?).await?;
+            Ok(json!({"schema": "crypto-account-list/v1", "items": accounts}))
+        }
+        "coinbase_transactions_list" => {
+            let account = str_arg(args, "account")?
+                .ok_or_else(|| CliError::Usage("`account` is required".into()))?;
+            let txns = queries::transactions(
+                client,
+                &account,
+                u32_arg(args, "limit")?,
+                str_arg(args, "since")?.as_deref(),
+                str_arg(args, "until")?.as_deref(),
+            )
+            .await?;
+            Ok(json!({"schema": "crypto-transaction-list/v1", "items": txns}))
+        }
+        other => Err(CliError::Usage(format!("unknown tool `{other}`"))),
+    }
+}
+
+fn str_arg(args: &Value, key: &str) -> Result<Option<String>, CliError> {
+    match args.get(key) {
+        None | Some(Value::Null) => Ok(None),
+        Some(Value::String(s)) if !s.trim().is_empty() => Ok(Some(s.trim().to_string())),
+        Some(_) => Err(CliError::Usage(format!(
+            "`{key}` must be a non-empty string"
+        ))),
+    }
+}
+
+fn u32_arg(args: &Value, key: &str) -> Result<Option<u32>, CliError> {
+    match args.get(key) {
+        None | Some(Value::Null) => Ok(None),
+        Some(v) => v
+            .as_u64()
+            .filter(|n| *n >= 1)
+            .and_then(|n| u32::try_from(n).ok())
+            .map(Some)
+            .ok_or_else(|| CliError::Usage(format!("`{key}` must be a positive integer"))),
+    }
+}
+
+fn bool_arg(args: &Value, key: &str) -> Result<bool, CliError> {
+    match args.get(key) {
+        None | Some(Value::Null) => Ok(false),
+        Some(Value::Bool(b)) => Ok(*b),
+        Some(_) => Err(CliError::Usage(format!("`{key}` must be a boolean"))),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::credential::Credential;
+    use crate::http::{HttpRequest, HttpResponse};
+    use std::cell::RefCell;
+
+    /// Serves canned pages and records what it was asked for.
+    struct Canned {
+        pages: RefCell<Vec<Value>>,
+        seen: RefCell<Vec<HttpRequest>>,
+    }
+
+    impl Transport for Canned {
+        async fn send(&self, req: HttpRequest) -> Result<HttpResponse, CliError> {
+            self.seen.borrow_mut().push(req);
+            let page = self.pages.borrow_mut().remove(0);
+            Ok(HttpResponse {
+                status: 200,
+                body: page.to_string(),
+            })
+        }
+    }
+
+    fn client(pages: Vec<Value>) -> Coinbase<Canned> {
+        let key = ed25519_dalek::SigningKey::from_bytes(&[7u8; 32]);
+        use base64::Engine as _;
+        let blob = json!({
+            "id": "test-key",
+            "privateKey": base64::engine::general_purpose::STANDARD.encode(key.to_keypair_bytes()),
+        });
+        let cred = Credential::parse(&blob.to_string()).unwrap();
+        Coinbase::with_transport(
+            cred,
+            "http://127.0.0.1:1",
+            Canned {
+                pages: RefCell::new(pages),
+                seen: RefCell::new(vec![]),
+            },
+            false,
+        )
+    }
+
+    fn run<F: std::future::Future>(f: F) -> F::Output {
+        use std::task::{Context, Poll, Waker};
+        let mut f = std::pin::pin!(f);
+        match f.as_mut().poll(&mut Context::from_waker(Waker::noop())) {
+            Poll::Ready(v) => v,
+            Poll::Pending => panic!("the canned transport never waits"),
+        }
+    }
+
+    #[test]
+    fn every_tool_is_listed_read_only() {
+        let tools = tools();
+        let tools = tools.as_array().unwrap();
+        assert_eq!(tools.len(), 2);
+        for t in tools {
+            assert_eq!(t["annotations"]["readOnlyHint"], true, "{}", t["name"]);
+            assert_eq!(t["inputSchema"]["type"], "object");
+        }
+    }
+
+    #[test]
+    fn accounts_list_hides_zero_balances_and_signs_each_request() {
+        let page = json!({
+            "data": [
+                {"id": "a1", "name": "BTC Wallet", "currency": {"code": "BTC"},
+                 "balance": {"amount": "0.00100000", "currency": "BTC"}},
+                {"id": "a2", "name": "DOGE Wallet", "currency": {"code": "DOGE"},
+                 "balance": {"amount": "0.00000000", "currency": "DOGE"}}
+            ],
+            "pagination": {"next_uri": null}
+        });
+        let c = client(vec![page]);
+        let out = run(call(&c, "coinbase_accounts_list", &json!({})));
+        assert_eq!(out["isError"], false);
+        let items = out["structuredContent"]["items"].as_array().unwrap();
+        assert_eq!(items.len(), 1);
+        assert_eq!(items[0]["id"], "a1");
+        let seen = c.transport_for_tests().seen.borrow();
+        let auth = &seen[0].headers[0];
+        assert_eq!(auth.0, "Authorization");
+        assert!(auth.1.starts_with("Bearer ey"));
+    }
+
+    #[test]
+    fn bad_arguments_are_tool_errors_with_the_exit_code() {
+        let c = client(vec![]);
+        let out = run(call(&c, "coinbase_transactions_list", &json!({"limit": 0})));
+        assert_eq!(out["isError"], true);
+        assert_eq!(out["structuredContent"]["error"]["exit_code"], 2);
+        let out = run(call(&c, "nope", &json!({})));
+        assert_eq!(out["structuredContent"]["error"]["code"], "usage");
+    }
+}
diff --git a/src/queries.rs b/src/queries.rs
new file mode 100644
index 0000000..e1d5fe4
--- /dev/null
+++ b/src/queries.rs
@@ -0,0 +1,163 @@
+//! The reads, independent of how they are asked for.
+//!
+//! `cbase accounts list` (clap, blocking) and the `coinbase_accounts_list` MCP
+//! tool (JSON, async in a Worker) are two front ends on the functions here, so
+//! a filter or paging rule changed in one place changes for both.
+
+use pk_cli_core::CliError;
+
+use crate::client::Coinbase;
+use crate::http::Transport;
+use crate::parse::{self, CryptoAccount, CryptoTransaction};
+
+/// Coinbase API paths the reads share.
+pub const ACCOUNTS: &str = "/v2/accounts";
+
+/// The transactions path for one account.
+pub fn account_transactions(account_id: &str) -> String {
+    format!("/v2/accounts/{account_id}/transactions")
+}
+
+/// Every wallet, zero balances hidden unless `all`.
+pub async fn accounts<T: Transport>(
+    client: &Coinbase<T>,
+    all: bool,
+    limit: Option<u32>,
+) -> Result<Vec<CryptoAccount>, CliError> {
+    let rows = client
+        .get_all(ACCOUNTS, &[], zero_filtered_limit(all, limit))
+        .await?;
+    let mut accounts = parse::accounts(&rows);
+    if !all {
+        accounts.retain(|a| !is_zero(&a.balance.amount));
+    }
+    if let Some(n) = limit {
+        accounts.truncate(n as usize);
+    }
+    Ok(accounts)
+}
+
+/// One account's ledger, bounded by an inclusive ISO date range.
+pub async fn transactions<T: Transport>(
+    client: &Coinbase<T>,
+    account: &str,
+    limit: Option<u32>,
+    since: Option<&str>,
+    until: Option<&str>,
+) -> Result<Vec<CryptoTransaction>, CliError> {
+    validate_range(since, until)?;
+    let path = account_transactions(account);
+    let rows = client
+        .get_all(&path, &[], fetch_limit(limit, since, until))
+        .await?;
+    let mut txns = parse::within(parse::transactions(&rows), since, until, |t| {
+        t.date.as_str()
+    });
+    if let Some(n) = limit {
+        txns.truncate(n as usize);
+    }
+    Ok(txns)
+}
+
+/// `--limit` counts records the user will *see*, but the zero-balance filter
+/// runs after paging — so when it is active the fetch must not stop at the
+/// limit or a page of empty wallets would swallow the whole result.
+fn zero_filtered_limit(all: bool, limit: Option<u32>) -> Option<u32> {
+    if all {
+        limit
+    } else {
+        None
+    }
+}
+
+/// The page walk can stop at `limit` only when nothing filters afterwards.
+/// With a date bound, the newest `limit` rows may all fall outside it.
+fn fetch_limit(limit: Option<u32>, since: Option<&str>, until: Option<&str>) -> Option<u32> {
+    if since.is_none() && until.is_none() {
+        limit
+    } else {
+        None
+    }
+}
+
+/// The same checks `RangeArgs::validate` makes, without clap: both bounds
+/// ISO `YYYY-MM-DD`, and `since` not after `until`.
+pub fn validate_range(since: Option<&str>, until: Option<&str>) -> Result<(), CliError> {
+    for (flag, v) in [("since", since), ("until", until)] {
+        if let Some(d) = v {
+            if parse::iso_date(&format!("{d}T00:00:00Z")).as_deref() != Some(d) {
+                return Err(CliError::Usage(format!(
+                    "{flag} must be an ISO date (YYYY-MM-DD), got `{d}`"
+                )));
+            }
+        }
+    }
+    if let (Some(s), Some(u)) = (since, until) {
+        if s > u {
+            return Err(CliError::Usage(format!("since ({s}) is after until ({u})")));
+        }
+    }
+    Ok(())
+}
+
+/// True for `"0"`, `"0.00000000"`, `"-0.0"`, and friends — without parsing a
+/// float, which would round a dust balance to zero and hide it.
+pub fn is_zero(amount: &str) -> bool {
+    let s = amount.trim().trim_start_matches(['+', '-']);
+    !s.is_empty() && s.chars().all(|c| c == '0' || c == '.')
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn transaction_paths_are_scoped_to_the_account() {
+        assert_eq!(
+            account_transactions("abc-123"),
+            "/v2/accounts/abc-123/transactions"
+        );
+    }
+
+    #[test]
+    fn zero_detection_does_not_go_through_a_float() {
+        for z in ["0", "0.0", "0.00000000", "-0.00000000", "+0", " 0.00 "] {
+            assert!(is_zero(z), "{z} should read as zero");
+        }
+        for nz in ["0.00000001", "1", "-0.5", "10.00", ""] {
+            assert!(!is_zero(nz), "{nz} should not read as zero");
+        }
+    }
+
+    #[test]
+    fn the_fetch_limit_is_dropped_when_zero_balances_are_filtered_out() {
+        assert_eq!(zero_filtered_limit(false, Some(5)), None);
+        assert_eq!(zero_filtered_limit(true, Some(5)), Some(5));
+        assert_eq!(zero_filtered_limit(true, None), None);
+    }
+
+    #[test]
+    fn a_bare_limit_is_pushed_down_to_the_fetch() {
+        assert_eq!(fetch_limit(Some(10), None, None), Some(10));
+        assert_eq!(fetch_limit(None, None, None), None);
+    }
+
+    #[test]
+    fn a_dated_query_must_not_stop_paging_at_the_limit() {
+        assert_eq!(fetch_limit(Some(10), Some("2025-01-01"), None), None);
+        assert_eq!(fetch_limit(Some(10), None, Some("2025-12-31")), None);
+    }
+
+    #[test]
+    fn a_malformed_or_inverted_range_is_a_usage_error() {
+        assert!(validate_range(Some("2025-01-01"), Some("2025-12-31")).is_ok());
+        assert!(matches!(
+            validate_range(Some("01/02/2025"), None),
+            Err(CliError::Usage(_))
+        ));
+        assert!(matches!(
+            validate_range(Some("2025-12-31"), Some("2025-01-01")),
+            Err(CliError::Usage(_))
+        ));
+    }
+}
