@@ -0,0 +1,100 @@
+//! The seam between the Coinbase client and whatever moves bytes.
+//!
+//! The terminal binary sends requests with a blocking `reqwest` client; a
+//! Cloudflare Worker has no threads and no sockets, only an async `fetch`. The
+//! client in [`crate::client`] is written once against [`Transport`], so the
+//! signing, URL building, pagination and error mapping are the same code on
+//! both, and only the ~20 lines that hand a request to the network differ.
+//!
+//! The trait is async because the Worker's side has to be. The native side
+//! implements it with a blocking call and drives it with [`block_on`], which
+//! never actually waits: a future whose body is a synchronous call is ready on
+//! its first poll.
+
+use pk_cli_core::CliError;
+
+use crate::jwt::Signer;
+
+/// One outgoing GET, fully described: the transport adds nothing but a
+/// connection. Query parameters stay separate from the URL so each transport
+/// percent-encodes them with its own (well-tested) encoder.
+#[derive(Debug, Clone)]
+pub struct HttpRequest {
+    pub method: &'static str,
+    pub url: String,
+    pub query: Vec<(String, String)>,
+    pub headers: Vec<(&'static str, String)>,
+}
+
+/// What the client needs back: the status and the body as text. The body is
+/// read as text, not JSON, because Coinbase answers some failures with a
+/// `text/plain` body (see [`crate::client::response_json`]).
+#[derive(Debug, Clone)]
+pub struct HttpResponse {
+    pub status: u16,
+    pub body: String,
+}
+
+/// Something that can send an [`HttpRequest`].
+///
+/// No `Send` bound: the Worker is single-threaded and the native binary polls
+/// on the calling thread, so neither side needs one, and requiring it would
+/// rule out `fetch`, whose futures hold JS values.
+#[allow(async_fn_in_trait)]
+pub trait Transport {
+    async fn send(&self, req: HttpRequest) -> Result<HttpResponse, CliError>;
+
+    /// Sign a JWT with the platform's own crypto, when it has faster crypto
+    /// than the pure-Rust signer. `None` (the default) means "use
+    /// [`Signer::sign`]".
+    ///
+    /// In a Worker, ES256 through WebCrypto runs in native code, which is the
+    /// difference between ~2 ms and well under 0.1 ms of CPU per request,
+    /// against a 10 ms free-plan budget per tool call. The output contract is
+    /// the same either way: the raw fixed-width JWS signature.
+    async fn sign(&self, _signer: &Signer, _input: &[u8]) -> Option<Result<Vec<u8>, CliError>> {
+        None
+    }
+}
+
+/// The native transport: the family's blocking `reqwest` client from
+/// `pk-cli-http`, with its user agent and timeouts.
+#[cfg(feature = "native")]
+pub struct BlockingTransport(pub reqwest::blocking::Client);
+
+#[cfg(feature = "native")]
+impl Transport for BlockingTransport {
+    async fn send(&self, req: HttpRequest) -> Result<HttpResponse, CliError> {
+        let mut rb = self.0.request(
+            reqwest::Method::from_bytes(req.method.as_bytes())
+                .map_err(|e| CliError::Other(format!("bad HTTP method: {e}")))?,
+            &req.url,
+        );
+        rb = rb.query(&req.query);
+        for (k, v) in &req.headers {
+            rb = rb.header(*k, v);
+        }
+        let resp = rb.send()?;
+        let status = resp.status().as_u16();
+        let body = resp.text().unwrap_or_default();
+        Ok(HttpResponse { status, body })
+    }
+}
+
+/// Run a future to completion on the current thread.
+///
+/// Only for futures that never wait on anything outside themselves — which is
+/// every future [`BlockingTransport`] produces. With a real async transport
+/// this would spin, so it is native-only.
+#[cfg(feature = "native")]
+pub fn block_on<F: std::future::Future>(fut: F) -> F::Output {
+    use std::task::{Context, Poll, Waker};
+    let mut fut = std::pin::pin!(fut);
+    let mut cx = Context::from_waker(Waker::noop());
+    loop {
+        if let Poll::Ready(v) = fut.as_mut().poll(&mut cx) {
+            return v;
+        }
+        std::thread::yield_now();
+    }
+}
